{
  "manifest_version": 3,
  "name": "Hub de Monitoramento do Portal",
  "version": "0.24.0",
  "description": "Painel por cima do Onvio para acompanhar o uso do Portal do Cliente: nomenclatura, pastas, clientes sem envio e notificações.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://onvio.com.br/*",
    "https://app.gestta.com.br/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hub de Monitoramento (abre por cima do Onvio)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "alternar-camada": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Abrir ou fechar o Hub de Monitoramento por cima do Onvio"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://onvio.com.br/*",
        "https://app.gestta.com.br/*"
      ],
      "js": [
        "src/overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.gestta.com.br/*"
      ],
      "js": [
        "src/gestta-aprender.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.gestta.com.br/*"
      ],
      "js": [
        "src/gestta-entrada.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://onvio.com.br/*"
      ],
      "js": [
        "src/onvio-aprender.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://onvio.com.br/*"
      ],
      "js": [
        "src/onvio-entrada.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/ponte-treinados.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "hub/*",
        "src/*"
      ],
      "matches": [
        "https://onvio.com.br/*",
        "https://app.gestta.com.br/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
